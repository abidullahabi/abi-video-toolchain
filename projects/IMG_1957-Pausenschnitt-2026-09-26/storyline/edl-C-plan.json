{
 "edl": "edl-C.json",
 "source": "/Users/abi/Library/Application Support/Google/DriveFS/canceled_uploads/107775308938735523322/IMG_1957.MOV",
 "useOriginal": true,
 "ending": 702.6,
 "pieces": [
  {
   "seg": 5,
   "from": "start",
   "to": "end",
   "start": 21.338333,
   "end": 23.605,
   "text": "In elf Monaten werde ich 30 und hier sind",
   "segs": [
    5
   ]
  },
  {
   "seg": 6,
   "from": "start",
   "to": "end",
   "start": 23.671667,
   "end": 24.138333,
   "text": "See",
   "segs": [
    6
   ]
  },
  {
   "seg": 7,
   "from": "start",
   "to": "end",
   "start": 24.238333,
   "end": 26.506667,
   "text": "Dinge, die ich meinem 20-jährigen Ich ...",
   "segs": [
    7
   ]
  },
  {
   "seg": 8,
   "from": "start",
   "to": "end",
   "start": 26.64,
   "end": 27.773333,
   "text": "einprügeln würde",
   "segs": [
    8
   ]
  },
  {
   "seg": 9,
   "from": "start",
   "to": "end",
   "start": 28.206667,
   "end": 29.606667,
   "text": "damit er glücklich durchs Leben geht.",
   "segs": [
    9
   ]
  },
  {
   "seg": 37,
   "from": "start",
   "to": "end",
   "start": 101.891667,
   "end": 104.191667,
   "text": "Punkt Nummer 1, fang früher an mit deiner Therapie.",
   "segs": [
    37
   ]
  },
  {
   "seg": 38,
   "from": "start",
   "to": "end",
   "start": 107.525,
   "end": 108.76,
   "text": "Wer hätte es gedacht",
   "segs": [
    38
   ]
  },
  {
   "seg": 39,
   "from": "start",
   "to": "end",
   "start": 109.326667,
   "end": 113.593333,
   "text": "Jeder hat eine Scheiß-Kinderheit gehabt. Unsere Eltern waren auch zum ersten Mal Menschen, sie machen auch Fehler.",
   "segs": [
    39
   ]
  },
  {
   "seg": 40,
   "from": "start",
   "to": "end",
   "start": 114.626667,
   "end": 117.628333,
   "text": "ist alles gut, aber es ist deine Aufgabe, jetzt diesen",
   "segs": [
    40
   ]
  },
  {
   "seg": 41,
   "from": "start",
   "to": "end",
   "start": 118.028333,
   "end": 119.495,
   "text": "Circle zu durchbrechen.",
   "segs": [
    41
   ]
  },
  {
   "seg": 43,
   "from": "start",
   "to": "end",
   "start": 121.495,
   "end": 123.696667,
   "text": "Heilung braucht Zeit, manchmal sogar lebenslange Zeit.",
   "segs": [
    43
   ]
  },
  {
   "seg": 44,
   "from": "start",
   "to": "end",
   "start": 129.065,
   "end": 131.831667,
   "text": "Die Seele braucht immer ein bisschen länger, bis sie das rafft.",
   "segs": [
    44
   ]
  },
  {
   "seg": 50,
   "from": "start",
   "to": "end",
   "start": 148.668333,
   "end": 151.703333,
   "text": "Ich hätte für mich gewünscht, dass ich viel früher damit anfange, um einfach",
   "segs": [
    50
   ]
  },
  {
   "seg": 51,
   "from": "start",
   "to": "end",
   "start": 153.436667,
   "end": 155.136667,
   "text": "nicht den Prozess zu beschleunigen, sondern",
   "segs": [
    51
   ]
  },
  {
   "seg": 52,
   "from": "start",
   "to": "end",
   "start": 155.236667,
   "end": 157.571667,
   "text": "mich auf dem Weg viele Dinge auch hätte vermeiden können.",
   "segs": [
    52
   ]
  },
  {
   "seg": 53,
   "from": "start",
   "to": "end",
   "start": 159.638333,
   "end": 160.338333,
   "text": "Zweitens.",
   "segs": [
    53
   ]
  },
  {
   "seg": 54,
   "from": "start",
   "to": "end",
   "start": 160.405,
   "end": 162.405,
   "text": "Zieh früh aus von zu Hause.",
   "segs": [
    54
   ]
  },
  {
   "seg": 55,
   "from": "start",
   "to": "end",
   "start": 167.14,
   "end": 171.641667,
   "text": "So wie ein Vogel sein Nest verlässt, um zu fliegen, musst du als Erwachsener",
   "segs": [
    55
   ]
  },
  {
   "seg": 57,
   "from": "start",
   "to": "end",
   "start": 173.441667,
   "end": 177.241667,
   "text": "früh von zu Hause ausziehen. Du kannst nicht erwachsen werden in deinem Kinderzimmer.",
   "segs": [
    57
   ]
  },
  {
   "seg": 95,
   "from": "start",
   "to": "end",
   "start": 289.57,
   "end": 291.303333,
   "text": "Und du musst halt rausgehen aus dem Kinderzimmer.",
   "segs": [
    95
   ]
  },
  {
   "seg": 96,
   "from": "start",
   "to": "end",
   "start": 291.636667,
   "end": 293.003333,
   "text": "und am besten auch in eine andere Stadt.",
   "segs": [
    96
   ]
  },
  {
   "seg": 98,
   "from": "start",
   "to": "end",
   "start": 294.903333,
   "end": 296.203333,
   "text": "Und das ist auch der dritte Punkt.",
   "segs": [
    98
   ]
  },
  {
   "seg": 65,
   "from": "start",
   "to": "end",
   "start": 196.58,
   "end": 200.381667,
   "text": "Viel zu wenig junge Menschen verbringen Zeit mit den drei wichtigsten Entscheidungen im Leben.",
   "segs": [
    65
   ]
  },
  {
   "seg": 66,
   "from": "start",
   "to": "end",
   "start": 201.315,
   "end": 201.915,
   "text": "Erstens.",
   "segs": [
    66
   ]
  },
  {
   "seg": 67,
   "from": "start",
   "to": "end",
   "start": 201.981667,
   "end": 202.881667,
   "text": "wo du wohnst,",
   "segs": [
    67
   ]
  },
  {
   "seg": 69,
   "from": "start",
   "to": "end",
   "start": 207.783333,
   "end": 210.15,
   "text": "Es macht einen Riesenunterschied, wenn du in einer großen Stadt wohnst,",
   "segs": [
    69
   ]
  },
  {
   "seg": 70,
   "from": "start",
   "to": "end",
   "start": 210.416667,
   "end": 214.385,
   "text": "Damit entscheidet sich viel über deine Karriere, wie viel Geld du verdienst, was für Urlaube du machst.",
   "segs": [
    70
   ]
  },
  {
   "seg": 72,
   "from": "start",
   "to": "end",
   "start": 218.551667,
   "end": 220.22,
   "text": "wenn du in seiner Popelstadt bleibst,",
   "segs": [
    72
   ]
  },
  {
   "seg": 73,
   "from": "start",
   "to": "end",
   "start": 220.353333,
   "end": 221.72,
   "text": "wird sich auch nicht viel ändern in deinem Leben.",
   "segs": [
    73
   ]
  },
  {
   "seg": 77,
   "from": "start",
   "to": "end",
   "start": 232.921667,
   "end": 234.956667,
   "text": "Der zweite Punkt sind die Leute um dich herum.",
   "segs": [
    77
   ]
  },
  {
   "seg": 80,
   "from": "start",
   "to": "end",
   "start": 240.29,
   "end": 241.858333,
   "text": "Wenn um dich herum nur Lutscher sind,",
   "segs": [
    80
   ]
  },
  {
   "seg": 81,
   "from": "start",
   "to": "end",
   "start": 242.058333,
   "end": 243.591667,
   "text": "ist zu 99 Prozent",
   "segs": [
    81
   ]
  },
  {
   "seg": 82,
   "from": "start",
   "to": "end",
   "start": 243.658333,
   "end": 245.258333,
   "text": "Auch du ein Lutscher.",
   "segs": [
    82
   ]
  },
  {
   "seg": 119,
   "from": "start",
   "to": "end",
   "start": 338.415,
   "end": 339.348333,
   "text": "Und der dritte.",
   "segs": [
    119
   ]
  },
  {
   "seg": 120,
   "from": "start",
   "to": "end",
   "start": 339.681667,
   "end": 341.381667,
   "text": "Vielleicht der wichtigste Punkt einem allen ist,",
   "segs": [
    120
   ]
  },
  {
   "seg": 121,
   "from": "start",
   "to": "end",
   "start": 341.615,
   "end": 342.881667,
   "text": "die Wahl deines Partners.",
   "segs": [
    121
   ]
  },
  {
   "seg": 122,
   "from": "start",
   "to": "end",
   "start": 344.248333,
   "end": 345.516667,
   "text": "Ich hätte mir einige",
   "segs": [
    122
   ]
  },
  {
   "seg": 123,
   "from": "start",
   "to": "end",
   "start": 345.783333,
   "end": 347.416667,
   "text": "Beziehungen um ein 20er sparen können.",
   "segs": [
    123
   ]
  },
  {
   "seg": 124,
   "from": "start",
   "to": "end",
   "start": 349.516667,
   "end": 354.818333,
   "text": "Es hat einen Riesen-Impact auf dein Glücksein, auf deine Zukunft und auch einfach generell die Ansicht auf Glück.",
   "segs": [
    124
   ]
  },
  {
   "seg": 125,
   "from": "start",
   "to": "end",
   "start": 355.185,
   "end": 356.551667,
   "text": "Liebe, die du entwickelst.",
   "segs": [
    125
   ]
  },
  {
   "seg": 126,
   "from": "start",
   "to": "end",
   "start": 359.32,
   "end": 361.32,
   "text": "Und der vierte Punkt ist:",
   "segs": [
    126
   ]
  },
  {
   "seg": 132,
   "from": "start",
   "to": "end",
   "start": 374.156667,
   "end": 378.256667,
   "text": "Mit 20 ging ich davon aus, ich wüsste schon alles. Ich dachte, ja, ich habe viel erlebt.",
   "segs": [
    132
   ]
  },
  {
   "seg": 133,
   "from": "start",
   "to": "end",
   "start": 378.456667,
   "end": 380.258333,
   "text": "habe viel Erfahrung gesammelt, habe schon viele",
   "segs": [
    133
   ]
  },
  {
   "seg": 134,
   "from": "start",
   "to": "end",
   "start": 380.691667,
   "end": 381.291667,
   "text": "Du hast",
   "segs": [
    134
   ]
  },
  {
   "seg": 135,
   "from": "start",
   "to": "end",
   "start": 381.591667,
   "end": 383.325,
   "text": "Keine Ahnung mit 20.",
   "segs": [
    135
   ]
  },
  {
   "seg": 136,
   "from": "start",
   "to": "end",
   "start": 383.758333,
   "end": 384.591667,
   "text": "Und das ist fine.",
   "segs": [
    136
   ]
  },
  {
   "seg": 143,
   "from": "start",
   "to": "end",
   "start": 400.461667,
   "end": 404.93,
   "text": "Ich hätte mir im Nachhinein einfach mehr gewünscht, den Druck rauszunehmen, erlaubt Fehler zu machen.",
   "segs": [
    143
   ]
  },
  {
   "seg": 144,
   "from": "start",
   "to": "end",
   "start": 405.23,
   "end": 408.565,
   "text": "Weil das es okay ist in den 20ern. Du hast ja gar keine Ahnung vom Leben überhaupt.",
   "segs": [
    144
   ]
  },
  {
   "seg": 154,
   "from": "start",
   "to": "end",
   "start": 434.37,
   "end": 435.636667,
   "text": "Oh, das ist mein Lieblingspunkt.",
   "segs": [
    154
   ]
  },
  {
   "seg": 155,
   "from": "start",
   "to": "end",
   "start": 435.736667,
   "end": 436.971667,
   "text": "Punkt Nummer 5:",
   "segs": [
    155
   ]
  },
  {
   "seg": 159,
   "from": "start",
   "to": "end",
   "start": 447.173333,
   "end": 451.008333,
   "text": "Du hast bereits Ziele erreicht, von denen du gesagt hast, dass sie dich glücklich machen.",
   "segs": [
    159
   ]
  },
  {
   "seg": 160,
   "from": "start",
   "to": "end",
   "start": 451.775,
   "end": 453.741667,
   "text": "Ich in meinen Zwanzigern, ich dachte...",
   "segs": [
    160
   ]
  },
  {
   "seg": 161,
   "from": "start",
   "to": "end",
   "start": 454.641667,
   "end": 455.708333,
   "text": "wenn ich diese Wohnung habe.",
   "segs": [
    161
   ]
  },
  {
   "seg": 162,
   "from": "start",
   "to": "end",
   "start": 455.741667,
   "end": 456.408333,
   "text": "Bin ich happy.",
   "segs": [
    162
   ]
  },
  {
   "seg": 163,
   "from": "start",
   "to": "end",
   "start": 457.343333,
   "end": 459.343333,
   "text": "Wenn ich mit dieser Partnerin zusammen bin, bin ich happy.",
   "segs": [
    163
   ]
  },
  {
   "seg": 164,
   "from": "start",
   "to": "end",
   "start": 460.21,
   "end": 465.811667,
   "text": "Wenn ich den Bachelor habe, wenn ich den Master habe, wenn ich diese Arbeit abgebe, dann bin ich endlich glücklich.",
   "segs": [
    164
   ]
  },
  {
   "seg": 165,
   "from": "start",
   "to": "end",
   "start": 466.845,
   "end": 469.445,
   "text": "Dann bin ich entspannt, dann bin ich nicht so gestresst, dann ist alles gut.",
   "segs": [
    165
   ]
  },
  {
   "seg": 166,
   "from": "start",
   "to": "end",
   "start": 469.811667,
   "end": 470.711667,
   "text": "Alles Quatsch.",
   "segs": [
    166
   ]
  },
  {
   "seg": 167,
   "from": "start",
   "to": "end",
   "start": 471.38,
   "end": 472.313333,
   "text": "Es ist immer",
   "segs": [
    167
   ]
  },
  {
   "seg": 168,
   "from": "start",
   "to": "end",
   "start": 472.68,
   "end": 474.446667,
   "text": "Nur der Weg, nie das Ziel.",
   "segs": [
    168
   ]
  },
  {
   "seg": 169,
   "from": "start",
   "to": "end",
   "start": 478.948333,
   "end": 480.681667,
   "text": "Und gehen wir weiter in den Weg Nummer 6.",
   "segs": [
    169
   ]
  },
  {
   "seg": 170,
   "from": "start",
   "to": "end",
   "start": 482.648333,
   "end": 484.248333,
   "text": "Es kommt niemand, um dich zu retten.",
   "segs": [
    170
   ]
  },
  {
   "seg": 179,
   "from": "start",
   "to": "end",
   "start": 509.721667,
   "end": 512.055,
   "text": "Ich hatte immer die Vorstellung, dass jemand kommt und mich rettet.",
   "segs": [
    179
   ]
  },
  {
   "seg": 180,
   "from": "start",
   "to": "end",
   "start": 513.023333,
   "end": 514.123333,
   "text": "Und dann bin ich happy.",
   "segs": [
    180
   ]
  },
  {
   "seg": 181,
   "from": "start",
   "to": "end",
   "start": 518.49,
   "end": 519.523333,
   "text": "ein Mentor,",
   "segs": [
    181
   ]
  },
  {
   "seg": 182,
   "from": "start",
   "to": "end",
   "start": 519.59,
   "end": 520.525,
   "text": "eine Frau",
   "segs": [
    182
   ]
  },
  {
   "seg": 183,
   "from": "start",
   "to": "end",
   "start": 520.925,
   "end": 521.791667,
   "text": "Einretter.",
   "segs": [
    183
   ]
  },
  {
   "seg": 184,
   "from": "start",
   "to": "end",
   "start": 525.658333,
   "end": 527.96,
   "text": "Der Fakt ist, es kommt niemand, um dich zu retten.",
   "segs": [
    184
   ]
  },
  {
   "seg": 185,
   "from": "start",
   "to": "end",
   "start": 530.026667,
   "end": 531.093333,
   "text": "Und das ist gar nicht schlimm.",
   "segs": [
    185
   ]
  },
  {
   "seg": 186,
   "from": "start",
   "to": "end",
   "start": 533.393333,
   "end": 534.928333,
   "text": "Die Person, die dich retten kann,",
   "segs": [
    186
   ]
  },
  {
   "seg": 187,
   "from": "start",
   "to": "end",
   "start": 536.395,
   "end": 537.461667,
   "text": "ist schon da.",
   "segs": [
    187
   ]
  },
  {
   "seg": 188,
   "from": "start",
   "to": "end",
   "start": 540.128333,
   "end": 543.296667,
   "text": "Wenn du selber verstehst, wie viel Macht du über dein eigenes Leben hast,",
   "segs": [
    188
   ]
  },
  {
   "seg": 189,
   "from": "start",
   "to": "end",
   "start": 555.2,
   "end": 558.133333,
   "text": "Dann kannst du erst richtig anfangen, dein eigenes Leben zu gestalten.",
   "segs": [
    189
   ]
  },
  {
   "seg": 190,
   "from": "start",
   "to": "end",
   "start": 560.666667,
   "end": 562.168333,
   "text": "Und hier nochmal ein paar praktische Tipps,",
   "segs": [
    190
   ]
  },
  {
   "seg": 191,
   "from": "start",
   "to": "end",
   "start": 562.235,
   "end": 563.568333,
   "text": "Fang früh an zu investieren.",
   "segs": [
    191
   ]
  },
  {
   "seg": 192,
   "from": "start",
   "to": "end",
   "start": 563.835,
   "end": 565.068333,
   "text": "Ich habe glaube ich über",
   "segs": [
    192
   ]
  },
  {
   "seg": 193,
   "from": "start",
   "to": "end",
   "start": 565.335,
   "end": 566.801667,
   "text": "20.000 Euro",
   "segs": [
    193
   ]
  },
  {
   "seg": 194,
   "from": "start",
   "to": "end",
   "start": 566.935,
   "end": 569.036667,
   "text": "immer in 20ern ausgeben, nur für Reisen.",
   "segs": [
    194
   ]
  },
  {
   "seg": 195,
   "from": "start",
   "to": "end",
   "start": 569.536667,
   "end": 571.536667,
   "text": "Ich bereue euch keine einzige Reise davon.",
   "segs": [
    195
   ]
  },
  {
   "seg": 197,
   "from": "start",
   "to": "end",
   "start": 573.736667,
   "end": 574.77,
   "text": "Gleich eins bis zwei nur.",
   "segs": [
    197
   ]
  },
  {
   "seg": 198,
   "from": "start",
   "to": "end",
   "start": 578.471667,
   "end": 582.806667,
   "text": "Aber wenn du jetzt mit 20 anfängst, 50, 100 oder auch mehr, mehrere 100 Euro ...",
   "segs": [
    198
   ]
  },
  {
   "seg": 199,
   "from": "start",
   "to": "end",
   "start": 582.906667,
   "end": 585.273333,
   "text": "pro Monat zur Seite zu legen, kannst du am Ende",
   "segs": [
    199
   ]
  },
  {
   "seg": 200,
   "from": "start",
   "to": "end",
   "start": 585.506667,
   "end": 587.706667,
   "text": "deinen 20ern auf eine fette Summe gucken und",
   "segs": [
    200
   ]
  },
  {
   "seg": 201,
   "from": "start",
   "to": "end",
   "start": 588.04,
   "end": 589.14,
   "text": "lebt es relativ gut schon.",
   "segs": [
    201
   ]
  },
  {
   "seg": 205,
   "from": "start",
   "to": "end",
   "start": 593.908333,
   "end": 595.675,
   "text": "Zeit ist die krasseste Ressource, die du hast,",
   "segs": [
    205
   ]
  },
  {
   "seg": 208,
   "from": "start",
   "to": "end",
   "start": 600.843333,
   "end": 603.411667,
   "text": "Vor allem beim Investieren bezahlt sich das sehr stark aus.",
   "segs": [
    208
   ]
  },
  {
