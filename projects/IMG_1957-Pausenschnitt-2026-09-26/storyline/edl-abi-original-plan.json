  {
   "seg": 57,
   "from": "start",
   "to": "end",
   "start": 173.441667,
   "end": 177.241667,
   "text": "früh von zu Hause ausziehen.\nDu kannst nicht erwachsen werden in deinem Kinderzimmer.\nZieh aus von zu Hause, am besten ziehst du auch in eine andere Stadt.\nUnd dann kommen wir zum dritten Punkt schon.",
   "segs": [
    57
   ]
  },
  {
   "seg": 58,
   "from": "start",
   "to": "end",
   "start": 179.876667,
